{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdc-cnpj.local/schemas/event-envelope-1.0.json",
  "title": "CDC-CNPJ Event Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "entity_key",
    "competencia_de",
    "competencia_para",
    "campos_alterados",
    "before",
    "after",
    "detected_at",
    "pipeline"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string" },
    "entity_key": { "type": "object", "additionalProperties": { "type": "string" } },
    "competencia_de": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "competencia_para": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "campos_alterados": { "type": "array", "items": { "type": "string" } },
    "before": { "type": "object", "additionalProperties": { "type": "string" } },
    "after": { "type": "object", "additionalProperties": { "type": "string" } },
    "detected_at": { "type": "string", "format": "date-time" },
    "pipeline": {
      "type": "object",
      "required": ["estrategia", "run_id"],
      "properties": {
        "estrategia": { "type": "string" },
        "run_id": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
