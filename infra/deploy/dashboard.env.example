# Copie para /etc/cdc-cnpj/dashboard.env e ajuste.
# systemd: EnvironmentFile=/etc/cdc-cnpj/dashboard.env

# Raiz do repositório clonado na VM
CDC_PROJECT_ROOT=/root/TCC

# Pasta data/ (manifests, measurements, canonical). Use o volume Hetzner se aplicável.
CDC_DATA_ROOT=/root/TCC/data

# API — escuta só em localhost; Nginx faz proxy público
CDC_API_BIND=127.0.0.1
CDC_API_PORT=8080

# Postgres (docker compose na mesma máquina)
CDC_JDBC_URL=jdbc:postgresql://127.0.0.1:5434/cdc_cnpj
CDC_JDBC_USER=cdc
CDC_JDBC_PASSWORD=cdc

# CORS: em produção deixe vazio (mesma origem via Nginx) ou defina a URL pública
# CDC_CORS_ORIGIN=https://dashboard.seudominio.tld

# --- Nginx (usado por setup-dashboard.sh, não pela JVM) ---
# DASHBOARD_SERVER_NAME=2.28.28.54
# DASHBOARD_AUTH_USER=admin
# DASHBOARD_AUTH_PASSWORD=altere-isso
